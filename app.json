{
  "expo": {
    "name": "Go Somewhere",
    "slug": "go-somewhere",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gosomewhere",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gosomewhere.app"
    },
    "android": {
      "package": "com.gosomewhere.app"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
